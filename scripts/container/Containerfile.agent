# Agent image: Claude Code plus the basic tools it drives, running as a non-root user.
# Build with 01-setup-podman.sh. Override the base for CUDA work, for example:
#   podman build --build-arg BASE_IMAGE=docker.io/nvidia/cuda:12.6.3-devel-ubuntu24.04 ...
# The NVIDIA driver libraries are injected at run time by CDI; the CUDA toolkit
# (nvcc, headers) has to come from the base image.
ARG BASE_IMAGE=docker.io/library/ubuntu:24.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git gh jq less openssh-client ripgrep \
      python3 python3-pip python3-venv build-essential \
      linux-tools-generic \
    && rm -rf /var/lib/apt/lists/* \
    # Ubuntu's /usr/bin/perf is a wrapper that looks for tools matching the RUNNING kernel,
    # which inside a container is the host's. Link the real binary so perf works on any host.
    && ln -s "$(ls /usr/lib/linux-tools-*/perf | head -n1)" /usr/local/bin/perf

# Fixed uid/gid 1000. The launcher maps your host user onto it with
# --userns=keep-id:uid=1000,gid=1000, so files in the mounted project keep your ownership.
RUN (userdel -r ubuntu 2>/dev/null || true) \
    && groupadd -g 1000 agent && useradd -m -u 1000 -g 1000 -s /bin/bash agent \
    && mkdir -p /workspace /home/agent/.claude && chown -R agent:agent /workspace /home/agent

# Managed settings outrank everything a repository can ship (see Stage 3).
COPY managed-settings.json /etc/claude-code/managed-settings.json
# System git config: HTTPS-only GitHub access using the token in $GH_TOKEN, if one is attached.
COPY gitconfig /etc/gitconfig
RUN chmod 0644 /etc/claude-code/managed-settings.json /etc/gitconfig

USER agent
WORKDIR /workspace
# Keep all Claude Code state, including the login, inside the one directory the
# launcher persists as a named volume.
ENV CLAUDE_CONFIG_DIR=/home/agent/.claude \
    DISABLE_AUTOUPDATER=1 \
    PATH=/home/agent/.local/bin:$PATH
# Native installer. Rebuild the image to update Claude Code.
RUN curl -fsSL https://claude.ai/install.sh | bash

ENTRYPOINT ["claude"]
